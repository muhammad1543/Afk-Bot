# Discord bot token from Discord Developer Portal
DISCORD_TOKEN=

# OpenAI-compatible LLM endpoint/key
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Optional GitHub token for private skill repositories
GITHUB_TOKEN=
SKILL_REPO=muhammad1543/Afk-Bot

# Runtime security
AGENT_REQUIRE_APPROVAL=true
AGENT_ALLOWED_USERS=
AGENT_WORKSPACE=./workspace

# Laptop worker
WORKER_SECRET=change-this-secret
AGENT_SERVER_URL=ws://127.0.0.1:8765/ws/worker
